# Oracle connection settings for the local development database.
# Copy this file to .env and replace the placeholder values.
ORACLE_USER=cloud_cost_app
ORACLE_PASSWORD=change-me
ORACLE_DSN=localhost:1521/FREEPDB1

# Optional: set to true to use python-oracledb Thick mode.
# Leave false for the default Thin mode, which does not require Oracle Client libraries.
ORACLE_THICK_MODE=false
ORACLE_CLIENT_LIB_DIR=
